{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "aes-clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib",
        "CMAKE_NM": "llvm-nm",
        "CMAKE_OBJDUMP": "llvm-objdump",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "aes-gcc",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_AR": "ar",
        "CMAKE_RANLIB": "ranlib",
        "CMAKE_NM": "nm",
        "CMAKE_OBJDUMP": "objdump",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=bfd",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "aes-clang-sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake-clang-sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_AR": "llvm-ar",
        "CMAKE_RANLIB": "llvm-ranlib",
        "CMAKE_NM": "llvm-nm",
        "CMAKE_OBJDUMP": "llvm-objdump",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "AES_FIXTURE_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "aes-clang",
      "configurePreset": "aes-clang"
    },
    {
      "name": "aes-gcc",
      "configurePreset": "aes-gcc"
    },
    {
      "name": "aes-clang-sanitizers",
      "configurePreset": "aes-clang-sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "aes-clang",
      "configurePreset": "aes-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "aes-gcc",
      "configurePreset": "aes-gcc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "aes-clang-sanitizers",
      "configurePreset": "aes-clang-sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
