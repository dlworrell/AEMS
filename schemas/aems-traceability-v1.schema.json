{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlworrell/AEMS/schemas/aems-traceability-v1.schema.json",
  "title": "AEMS Traceability Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "owner_repository",
    "nodes",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 7
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "artifactClass": {
      "enum": [
        "governance",
        "standard",
        "requirement",
        "specification",
        "decision",
        "research",
        "risk",
        "issue",
        "commit",
        "implementation",
        "test",
        "evidence",
        "waiver",
        "release"
      ]
    },
    "relationshipType": {
      "enum": [
        "governs",
        "defines",
        "derives-from",
        "depends-on",
        "tracks",
        "implements",
        "verifies",
        "evidences",
        "mitigates",
        "waives",
        "supersedes",
        "released-in",
        "owned-by"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact_class",
        "title",
        "repository",
        "authority",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_class": {
          "$ref": "#/$defs/artifactClass"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "authority": {
          "enum": [
            "canonical",
            "reference",
            "generated-evidence"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/relationshipType"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
