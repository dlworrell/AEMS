{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dlworrell/AEMS/schemas/aes-bld-001-evidence-v1.schema.json",
  "title": "AES-BLD-001 build and distribution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standard",
    "mode",
    "repository",
    "root",
    "profile",
    "generated_at",
    "runner",
    "tools",
    "checks",
    "manifests",
    "waivers",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "standard": {
      "const": "AES-BLD-001"
    },
    "mode": {
      "enum": [
        "structure",
        "parity"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "release",
        "machine",
        "python"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "python": {
          "type": "string"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "enum": [
              "available",
              "missing",
              "failed"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "status",
          "message",
          "evidence"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^AES-BLD-001-R[0-9]{3}$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-applicable"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "kind",
            "digest"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "file",
                "symlink"
              ]
            },
            "digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "rationale",
          "owner",
          "reviewer",
          "compensating_validation",
          "expires_on",
          "state"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^AES-BLD-001-R[0-9]{3}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "compensating_validation": {
            "type": "string",
            "minLength": 1
          },
          "expires_on": {
            "type": "string",
            "format": "date"
          },
          "state": {
            "enum": [
              "active",
              "expired"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "not-applicable",
        "result"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not-applicable": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    }
  }
}
